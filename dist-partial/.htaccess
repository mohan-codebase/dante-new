# =============================================================================
# PARTIAL CUTOVER — 57 pages are static, the rest still run on PHP.
#
# Only the migrated slugs redirect. Every other .php URL is left alone so the
# old site keeps serving it untouched. Replace this with the full .htaccess in
# the repo root once the remaining pages are migrated.
# =============================================================================

# Serve the new static homepage for "/" ahead of the old index.php.
# NOTE: index.html must be uploaded, or "/" falls through to index.php and the
# redirect below turns into a loop.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (safe for the whole site).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # The homepage was reachable at both / and /index.php.
  RewriteRule ^index\.php$ / [R=301,L]

  # The migrated pages: legacy .php -> new .html
  RewriteRule ^(invisalign|braces|about|dublin-ca-orthodontic-office-contact|tracy-ca-orthodontic-office-contact|before-after|blog|blog/how-much-do-braces-cost|blog/whats-the-best-age-for-braces|blog/how-long-do-you-have-to-wear-a-retainer|blog/invisalign-treatment-for-adults-cost-timeline|blog/does-invisalign-work-for-crowded-teeth|blog/tmj-treatment-options|blog/botox-for-tmj-cost|blog/botox-for-bruxism|blog/tmj-headaches|blog/botox-for-tmj|blog/what-is-tmj-disorder|blog/invisalign-for-crowded-teeth|blog/invisalign-for-adults|blog/can-you-wear-invisalign-only-at-night|blog/can-invisalign-fix-an-overbite|blog/can-invisalign-fix-an-underbite|blog/braces-create-small-gap-between-front-teeth-is-it-normal|blog/braces-vs-invisalign|blog/can-braces-fix-an-overbite-permanently|blog/can-invisalign-fix-protruding-front-teeth|blog/can-orthodontic-treatment-help-sleep-apnea|blog/can-tmj-dysfuntion-cause-ear-pain|blog/can-you-chew-gum-with-invisalign-without-affecting-your-treatment|blog/can-you-chew-gum-with-invisalign|blog/can-you-drink-with-invisalign|blog/can-you-eat-with-invisalign|blog/can-you-get-braces-with-missing-teeth-heres-what-orthodontists-say|blog/can-you-really-straighten-teeth-without-braces|blog/crowded-teeth-before-and-after|blog/do-braces-hurt-how-long-the-pain-lasts-and-how-to-cope|blog/do-braces-or-invisalign-hurt-what-to-expect-during-your-first-week|blog/does-invisalign-hurt-more-than-braces|blog/does-invisalign-hurt|blog/how-braces-can-correct-crooked-teeth-a-complete-guide|blog/how-braces-can-lead-to-white-marks-and-what-you-can-do-about-it|blog/how-to-brush-teeth-with-braces|blog/how-to-clean-invisalign-properly|blog/how-to-fix-a-gap-between-teeth-treatment-options-compared|blog/invisalign-vs-braces-choosing-the-right-option-for-your-smile|blog/jaw-pain-on-one-side|blog/overbite-vs-underbite|blog/the-best-solutions-on-how-to-fix-crowded-teeth-effectively|blog/the-best-techniques-to-floss-teeth-with-braces-effectively|blog/what-causes-crowded-teeth-and-how-dentists-fix-them|blog/what-is-a-deep-bite|blog/what-is-an-underbite|blog/what-is-malocclusion-of-teeth|blog/what-is-sleep-apnea-caused-by|blog/what-is-teeth-protrusion)\.php$ /$1.html [R=301,L]
</IfModule>

# NOT included in this partial bundle, on purpose:
#   * ErrorDocument 404 /404.html  — 404.html is not part of this batch.
#   * non-www -> www canonicalisation — a site-wide change affecting the 53
#     pages still on PHP. Do it at full cutover, not mid-migration.
