  "meta": {
    "title": "Do Braces or Invisalign Hurt More? Find Out",
    "description": "Wondering whether braces or Invisalign hurt more? Compare comfort levels, pain duration, and what to expect during treatment.",
    "keywords": "Do Braces Hurt",
