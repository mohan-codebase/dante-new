  "meta": {
    "title": "Can You Eat With Invisalign? Foods, Rules & Expert Tips",
    "description": "Wondering if you can eat with Invisalign? Learn the essential rules, foods to avoid, and expert tips to keep your treatment on track and your smile beautiful.",
    "keywords": "eat with Invisalign, Invisalign food rules, Invisalign eating routine, Dante Gonzales Orthodontics, Invisalign care, oral hygiene Invisalign",
